<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Limescape.Umbraco.OaiPmh</PackageId>
    <RootNamespace>Limescape.Umbraco.OaiPmh</RootNamespace>
    <Title>Limescape OAI-PMH provider for Umbraco</Title>
    <Description>OAI-PMH 2.0 data provider for Umbraco CMS: exposes published content to harvesters in Dublin Core (oai_dc), with persistent deleted records and resumption tokens.</Description>
    <PackageTags>umbraco;umbraco-marketplace;oai-pmh;dublin-core;harvesting;metadata</PackageTags>
    <VersionPrefix>1.0.0</VersionPrefix>
    <RepositoryUrl>https://github.com/TrueLimeNL/limescape.umbraco.oaipmh</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TrueLimeNL/limescape.umbraco.oaipmh</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official schemas, embedded so responses can be validated offline (tests, diagnostics). -->
    <EmbeddedResource Include="Schemas\*.xsd" LogicalName="Limescape.Umbraco.OaiPmh.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Limescape.Umbraco.OaiPmh.Tests" />
  </ItemGroup>

</Project>
